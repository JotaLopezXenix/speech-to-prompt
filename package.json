{
  "name": "speech-to-prompt",
  "version": "1.0.0",
  "description": "Convierte dictados de voz en prompts optimizados para Claude Opus",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env --env-file-if-exists=.env.dev server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate-db.js",
    "seed-prompts": "node --env-file-if-exists=.env scripts/seed-prompts.js",
    "launch": "launcher.bat"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@azure/identity": "^4.5.0",
    "@azure/storage-blob": "^12.26.0",
    "express": "^4.21.2",
    "mssql": "^11.0.1",
    "multer": "^2.1.1",
    "open": "^10.1.0"
  }
}
